Package: canhrActi
Title: CANHR Accelerometer Physical Activity and Sleep Analysis
Version: 0.3.1
Authors@R: c(
    person("Raymond Dacosta", "Azadda",
           email = "rdazadda@alaska.edu",
           role = c("aut", "cre")),
    person("Andrew", "Grogan-Kaylor",
